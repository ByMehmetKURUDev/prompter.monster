# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored — never commit real keys.

# --- Faz 1: AI features (AI Enhance, AI Önerisi, "Bu promptu iyileştir") ---
# Create a key at https://console.anthropic.com  → API Keys
ANTHROPIC_API_KEY=
# Model used for AI calls (any current Claude model id works)
ANTHROPIC_MODEL=claude-sonnet-4-5
# Free AI calls per IP per day for visitors without an account
FREE_AI_CALLS_PER_DAY=3

# --- Faz 2: accounts & library (Supabase) — not wired yet ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Faz 3: payments — not wired yet ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PRICE_PRO_MONTHLY=
IYZICO_API_KEY=
IYZICO_SECRET_KEY=

# --- Site (Cloudflare'da wrangler.jsonc vars ile ayarlanır) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
