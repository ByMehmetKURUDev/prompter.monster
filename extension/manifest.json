{
  "manifest_version": 3,
  "name": "Prompter.Monster — Tek Tık Aktar",
  "short_name": "Prompter.Monster",
  "version": "1.0.0",
  "description": "Prompter.Monster'da kopyaladığın master prompt'u ChatGPT, Claude, Gemini ve benzeri AI araçlarına tek tıkla yapıştır.",
  "default_locale": "tr",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Prompter.Monster: Panodakini AI aracına aktar"
  },
  "permissions": ["activeTab", "scripting", "clipboardRead", "storage"]
}
